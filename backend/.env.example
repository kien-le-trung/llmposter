APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/llmposter
INFERENCE_MODE=remote
LLM_CONFIG={"name":"OpenRouter default","provider":"openrouter","chat_url":"https://openrouter.ai/api/v1/chat/completions","model":"openrouter/free","api_key_env":"OPENROUTER_API_KEY","min_max_tokens":10000,"structured_max_tokens":10000,"max_concurrent_requests":4}
GROK_API_KEY=
# Optional JSON override for the primary provider; set GROK_CONFIG=null to use LLM_CONFIG only.
# GROK_CONFIG={"name":"Grok default","provider":"grok","chat_url":"https://api.x.ai/v1/chat/completions","model":"grok-4.7","api_key_env":"GROK_API_KEY","max_concurrent_requests":4}
OPENROUTER_API_KEY=
EMBEDDING_MODEL_SERVER_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_MODEL_NAME=gemini-embedding-001
GEMINI_API_KEY=
AGENT_CONFIG_SOURCE=static
WORD_SELECTION_MODE=random
FIXED_SECRET_WORD=satellite
FIXED_IMPOSTER_HINT=orbit

# Discussion is enabled by default for human rounds.
DISCUSSION_ENABLED=true
DISCUSSION_DURATION_SECONDS=90
