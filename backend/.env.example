APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/llmposter
INFERENCE_MODE=remote
LLM_CONFIG={"name":"GLM 5.3 Flash via OpenRouter","provider":"openrouter","chat_url":"https://openrouter.ai/api/v1/chat/completions","model":"z-ai/glm-5.3-flash","api_key_env":"OPENROUTER_API_KEY","min_max_tokens":10000,"structured_max_tokens":10000,"max_concurrent_requests":4}
OPENROUTER_API_KEY=
EMBEDDING_MODEL_SERVER_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_MODEL_NAME=gemini-embedding-001
GEMINI_API_KEY=
AGENT_CONFIG_SOURCE=static
WORD_SELECTION_MODE=random
FIXED_SECRET_WORD=satellite
FIXED_IMPOSTER_HINT=orbit

# Discussion is enabled by default for human rounds.
DISCUSSION_DURATION_SECONDS=90

# Debate scheduling (seconds) and shared inference capacity.
DISCUSSION_DEBOUNCE_SECONDS=0.5
DISCUSSION_COOLDOWN_SECONDS=2
DISCUSSION_SILENCE_SECONDS=10
DISCUSSION_MAX_CONCURRENT_TURNS=4
